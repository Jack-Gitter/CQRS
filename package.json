{
  "name": "cqrs-airline",
  "version": "1.0.0",
  "private": true,
  "description": "CQRS demo: NestJS + TypeORM, write/read Postgres, Debezium CDC through Kafka, separate projector service",
  "scripts": {
    "build": "nest build api && nest build projector",
    "build:api": "nest build api",
    "build:projector": "nest build projector",
    "start:api": "nest start api --watch",
    "start:projector": "nest start projector --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.7.2"
  }
}
